<?xml version="1.0" encoding="utf-8"?>
<!-- Gedeeld door het blokkeerscherm (BlockActivity) en het hoofdscherm van de ouder (MainActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/block_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/block_subtitle"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/pin_input"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:hint="@string/block_pin_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="12"
            android:nextFocusDown="@+id/minutes_input"
            android:singleLine="true"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/block_minutes_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/minutes_input"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:singleLine="true"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/pin_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#C62828"
            android:textSize="16sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/unlock_button"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/block_unlock" />

        <Button
            android:id="@+id/settings_button"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_settings"
            android:visibility="gone" />

        <Button
            android:id="@+id/back_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/block_back" />
    </LinearLayout>
</ScrollView>
